                callAjax("/pub/login.ashx", "dologin=0", waitforUserid);
            }


            function waitforUserid(data) {
                var userArray = []
                if (data !== undefined) { userArray = data.split(',') }
                if (userArray.length < 2) { userArray = ""; }
                if ($.isArray(userArray)) {
                    var userid = userArray[0];
                    var username = userArray[1];
                    var friendlyname = userArray[2];
                    if (userid == 5) {
                        //$("#loginbox").html("Hi SUPPORT" + "<span class='btnlogout' id='btnlogout' onclick='doLogout();'> [Logout]</span>" + "<br><span class='btnlogout' onclick='maintainuser();'>Reset Password</span>");
                        $("#loginbox").html("Hi SUPPORT" + "<span class='btnlogout' id='btnlogout'> [Logout]</span>" + "<br><span class='btnlogout' onclick='maintainuser();'>Reset Password</span>");
                    }
                    else {
                        //$("#loginbox").html("Hi " + friendlyname + "<span class='btnlogout' id='btnlogout' onclick='doLogout();'> [Logout]</span>");
                        $("#loginbox").html("Hi " + friendlyname + "<span class='btnlogout' id='btnlogout'> [Logout]</span>");
                    }
                    $("#content").show();
                    $("#edtPass").val('');
                    $("#edtUser").val('');
                    $("#loginform").hide();
                    $("#heading").show();
                    buttonclicked = false;

                    $("#dashboard_menubar").attr("disabled", false).removeClass("ui-state-disabled"); /* MFT NEW NAV  */
                    $("#dashboardoptions").attr("disabled", false).removeClass("ui-state-disabled"); /* MFT NEW NAV  */
                    $("#datafilter").attr("disabled", false).removeClass("ui-state-disabled"); /* MFT NEW NAV  */

                    var params = "userid=" + readCookie("userid")
                    Ajax_CreateDashboardMenu("/members/createDashboardSpace.ashx", params);
                    Ajax_CreateContextMenu("/members/createContextMenu.ashx", params);

                    ToggleDashboardsMenu();

                }
                else {
                    if (buttonclicked) { alert("Invalid Username or Password"); buttonclicked = false; $("#edtPass").val(''); }
                    $("#loginbox").html("Hi Guest. Please login to continue");
                    $("#content").hide();
                    $("#heading").hide();
                    $("#loginform").show();
                    InitializeScreen();
                }
            }
            function onSignIn(googleUser) {
                var profile = googleUser.getBasicProfile();
                var email = profile.getEmail();
                callAjax("/pub/login.ashx", "dologin=1&user=" + 'google:' + email + "&pass=''", waitforUserid);
            }
            function doLogin() {
                buttonclicked = true;

                var defaultpage = $('input[name=selectDefault]:checked').val()
                var user = $("#edtUser").val();
                var pass = $("#edtPass").val();
                callAjax("/pub/login.ashx", "dologin=1&user=" + user + "&pass=" + pass + "&defaultpage=" + defaultpage, waitforUserid);

//                var params = "userid=" + readCookie("userid")
//                Ajax_CreateDashboardMenu("/members/createDashboardSpace.ashx", params);
//                Ajax_CreateContextMenu("/members/createContextMenu.ashx", params);

            }

