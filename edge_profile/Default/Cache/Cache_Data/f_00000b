function UserProfile() {

    $("#content").hide();
    $("#heading").hide();

    var wWidth = $(window).width();
    var dWidth = wWidth * 0.4;
    var wHeight = $(window).height();
    var dHeight = wHeight * 0.95;


    $("#dialogdrill").dialog({
        width: dWidth,
        height: dHeight,
        resizable: false,
        modal: true,
        closeOnEscape: false,
        open: function (ev, ui) {
            $("#DashboardSelectArea").hide();
            $('#heading').hide();
            $("#DashboardContextArea").slideUp();
            $('#dialogdrill').css('overflow', 'hidden');
            $('#myIframe').attr('src', 'user_maintain.html');
            $('#myIframe').css('overflow', 'hidden');
            $(".ui-dialog-titlebar-close", ui.dialog | ui).hide();
            $("#mw_buttonbarcustom_").show();
            $("#mw_buttonokcustom_").show();
            $("#mw_buttoncancelcustom_").show();

        },
        close: function () {
            $("#DashboardSelectArea").show();
            $('#heading').show();
            $("#content").show();

        }

    })


    $(document).ready(function () {
        $("#mw_buttoncancelcustom_").click(function () { closedetails(); });
        $("#mw_buttonokcustom_").click(function () { savedetails(); });
    });


};