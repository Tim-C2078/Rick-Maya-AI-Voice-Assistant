            AutoZoomFitToScreen_MSIE();
        }
        else if (IS_CHROME() == 1) {
            AutoZoomFitToScreen_CHROME();
        }
        else {
            AutoZoomFitToScreen_MSIE();
        }
    }
    else    {    // BACK TO ACTUAL SCREEN SIZE

        $(document.body).css("zoom", "100%");

        if (IS_IPAD() == 1) {
            $(".FixedHeader_Cloned").css("zoom", "100%");
        }

        $("#headingstatustext").removeClass("FitToActual");  //text("100 %");
        $("#headingstatustext").addClass("FitToWidth");
        $(".heading").css("zoom", "100%");
        var headingPixelH = 35;  //$(".heading").innerHeight();


        if (IS_IPAD() == 1) {
            var Top100Perc = (headingPixelH);
            $("#content").css("top", Top100Perc + "px");
            $(".FixedHeader_Cloned").css("top", newTop + "px");
        }
        else if (IS_CHROME() == 1) {
            //$(".FixedHeader_Cloned").css("zoom", document.body.style.zoom);
            $(".FixedHeader_Cloned").css("zoom", "100%");
            $("#content").css("top", "34px")
        } 
        else if (IS_MSIE() == 1) {
            $("#content").css("top", "34px")
        }

        //Forces heading to refesh with new zoom factor
        $("#content").hide();
        $("#content").get(0).offsetHeight;
        $("#content").show();
    }

}


