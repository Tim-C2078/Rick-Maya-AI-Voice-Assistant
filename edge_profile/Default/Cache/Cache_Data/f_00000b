function currentDateTime() {
    var d = new Date;
    var dDay = d.getDate();
    var dMonth = d.getMonth() + 1;
    var dYear = d.getFullYear();
    return dDay + "/" + dMonth + "/" + dYear + " " + d.toLocaleTimeString();

}

//  MTitus
function currentDateTimeYMD_HMS() {
    var d = new Date;
    var dDay = d.getDate();
    var dMonth = d.getMonth() + 1;
    var dYear = d.getFullYear();

    var dHours = d.getHours();
    var dMinutes = d.getMinutes();
    var dSeconds = d.getSeconds();

    return dYear + "" + dMonth + "" + dDay + "" + dHours + "" + dMinutes + "" + dSeconds
}

