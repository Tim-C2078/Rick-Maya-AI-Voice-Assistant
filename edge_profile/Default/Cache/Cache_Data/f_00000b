function HideDateParams(unique_id, action) {
    if (action == 'hide') {

        var rep_title = $("#toolbar_" + unique_id).find('.reporttitle-grey:first');

        $(rep_title).find(".reporttitle-DateParamLabel").each(function () 
        {
            $(this).hide();
        });
    }
    else if (action == 'show') {
        var rep_title = $("#toolbar_" + unique_id).find('.reporttitle-grey:first');

        $(rep_title).find(".reporttitle-DateParamLabel").each(function () {
            
            var datevalue = $(this).find(".DateLabels:first").text();
            
            if (datevalue.length >= 4) {
                $(this).show();
            }
            else {
                $(this).hide();
            }
        });
    }

}


