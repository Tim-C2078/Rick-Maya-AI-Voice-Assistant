$.timerPool.pauseAll = function () {
    $(this).each(function (idx, timer) {
    try {
        timer.stop();}
    catch(err) {
    }
    });
}

$.timerPool.activeCount = function () {
    var cnt = 0;
    $(this).each(function (idx, timer) {
        if (timer.active) { cnt = cnt + 1; }
    });
    return cnt;
}

$.timerPool.resumeAll = function () {
    if (readCookie('autoUpdate') !== 'false') {
        $(this).each(function (idx, timer) {
            timer.play();
        });
    }
}

function startTimer(action, interval) {
    $.timerPool.push($.timer(action, interval, true));
    if (readCookie('autoUpdate') == 'false') {
        $.timerPool.pauseAll();
    }
 }


$.ajaxSetup({
    timeout: 120000,
    dataType: 'html',
    beforeSend: function (jqXHR) {
        var userid = readCookie("userid");
        var run = true
        if (userid == null) {
            eraseCookie(".ASPXAUTH");
            if (this.url.slice(0, 15) !== "/pub/login.ashx") {
                location.reload();
                run = false;
            }

        }
        if (run) {
            $.xhrPool.push(jqXHR);
        }
        else { $.xhrPool.abortAll; return false; }
    },
    complete: function (jqXHR) {
        var index = $.inArray(jqXHR,$.xhrPool);
        if (index > -1) {
            $.xhrPool.splice(index, 1);
        }
    }
});

